# Solo para desarrollo local. Nunca publiques SERVICE_ROLE_KEY ni expongas este proxy.
SUPABASE_URL=https://your-project.supabase.co
SERVICE_ROLE_KEY=your_service_role_key_here
PORT=9000

# Orígenes del sitio que pueden usar el proxy local (separados por comas).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Tablas a las que este proxy puede insertar (separadas por comas).
# Ajusta la lista al esquema real antes de arrancar el servidor.
ALLOWED_TABLES=registrations,speakers
